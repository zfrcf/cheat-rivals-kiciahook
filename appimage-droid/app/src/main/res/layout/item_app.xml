<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingHorizontal="16dp" android:paddingVertical="10dp">

    <ImageView android:id="@+id/icon"
        android:layout_width="48dp" android:layout_height="48dp"
        android:importantForAccessibility="no" android:scaleType="fitCenter" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textSize="17sp" />
        <TextView android:id="@+id/details"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:alpha="0.7" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
