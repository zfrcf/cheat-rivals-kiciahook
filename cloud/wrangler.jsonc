{
  // PhonePilot — mode cloud (aucun Mac requis).
  "name": "phonepilot",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PHONE", "class_name": "PhoneHubDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhoneHubDO"] }],
  // L'APK de l'app est servie par le même déploiement : https://<serveur>/PhonePilot.apk
  "assets": { "directory": "./public" },
  "observability": { "enabled": true }
}
