  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "typeRoots": ["./node_modules/@types", "./node_modules", "../bridge/node_modules/@types"]
  },
  "include": ["src"]
}
